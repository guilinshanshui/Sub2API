# Data directory must live outside the source tree in production.
SUB2API_DATA_DIR=./data
SUB2API_HOST=127.0.0.1
SUB2API_PORT=8787
SUB2API_PUBLIC_URL=http://127.0.0.1:8787
# Optional override for the compiled Web UI. Defaults to apps/web/dist.
SUB2API_WEB_DIST=

# Optional bootstrap API key. Leave empty and create keys from the admin UI.
SUB2API_API_KEY=

# Optional management password. Leave empty to print a one-time setup token on first launch.
SUB2API_ADMIN_PASSWORD=

# Comma-separated model allowlist. Empty means all models are visible.
SUB2API_ALLOWED_MODELS=

# Optional request defaults.
SUB2API_DEFAULT_PROVIDER=
SUB2API_DEFAULT_MODEL=
SUB2API_REQUEST_TIMEOUT_MS=300000
# Automatic account credential refresh interval. Set 0 to disable.
SUB2API_SCHEDULER_INTERVAL_MS=1800000

# Comma-separated browser origins allowed to call the gateway cross-origin.
# Leave empty for same-origin or Vite proxy deployments.
SUB2API_CORS_ORIGINS=

SUB2API_LOG_LEVEL=info
